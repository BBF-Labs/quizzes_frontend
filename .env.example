NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google OAuth (Phase A) — public web client_id obtained from Google Cloud
# Console → APIs & Services → Credentials. Used by the Google Identity Services
# script loaded on the login/signup pages to render the in-page consent popup.
# This value is NOT a secret (Google publishes it in the browser by design) and
# must match the GOOGLE_CLIENT_ID configured in the backend for id_token
# verification. See quizzes_backend/README.md → "OAuth Setup" for how to
# register the OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=