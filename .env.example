NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# OAuth is handled fully by the backend (authorization-code flow). The browser
# navigates to /api/v1/auth/oauth/google/start, bounces through Google, and
# lands back on /api/v1/auth/oauth/google/callback. No OAuth env vars are needed
# on the frontend — see quizzes_backend/README.md → "OAuth Setup" for the Google
# Cloud Console configuration (Authorized JavaScript origins + redirect URIs).